#!/bin/sh
# The clone's own pre-push hook, if any, then every hook on the whole tree, exactly
# as CI's Lint job runs them. Git passes the refs being pushed on stdin; only the
# clone's hook reads them.
"$(dirname "$0")/run-local" pre-push "$@" || exit $?
exec "$(dirname "$0")/run-hooks" run --all-files --show-diff-on-failure </dev/null
